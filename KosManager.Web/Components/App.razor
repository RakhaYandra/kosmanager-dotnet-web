<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&family=Space+Grotesk:wght@400;500&family=JetBrains+Mono:wght@600&display=swap" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="theme.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="KosManager.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script>
        window.kmDownload = (name, b64) => {
            const a = document.createElement("a");
            a.href = "data:text/csv;base64," + b64;
            a.download = name;
            a.click();
        };
        window.kmDownloadPdf = (name, b64) => {
            const a = document.createElement("a");
            a.href = "data:application/pdf;base64," + b64;
            a.download = name;
            a.click();
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
