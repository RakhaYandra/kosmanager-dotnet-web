@page "/bills"
@inject BillingService Billing
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Tagihan — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="d-flex align-center gap-3 mb-4">
        <MudText Typo="Typo.h4" Style="font-weight:700;">Tagihan</MudText>
        <MudSpacer />
        @if (Auth.IsOwner)
        {
            <MudTextField T="string" Label="Periode" Placeholder="2026-10" @bind-Value="periode" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:140px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate">Generate</MudButton>
        }
    </div>
    <MudSelect T="string" Label="Status" Value="status" ValueChanged="OnStatus" Variant="Variant.Outlined" Dense="true" Style="width:200px" Class="mb-3">
        <MudSelectItem Value="@("")">Semua</MudSelectItem>
        <MudSelectItem Value="@("unpaid")">Belum</MudSelectItem>
        <MudSelectItem Value="@("pending")">Pending</MudSelectItem>
        <MudSelectItem Value="@("paid")">Lunas</MudSelectItem>
    </MudSelect>
    @if (!loaded) { <MudProgressCircular Indeterminate="true" /> }
    else if (bills.Count == 0) { <MudAlert Severity="Severity.Success">Belum ada tunggakan 🎉</MudAlert> }
    else
    {
        <MudTable Items="bills" Hover="true" Elevation="2" Context="r">
            <HeaderContent>
                <MudTh>Penghuni</MudTh><MudTh>Periode</MudTh><MudTh>Nominal</MudTh><MudTh>Jatuh tempo</MudTh><MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@r.Tenant</MudTd>
                <MudTd Class="mono">@r.Period</MudTd>
                <MudTd Class="mono">@r.Amount</MudTd>
                <MudTd Class="mono">@r.Due</MudTd>
                <MudTd><StatusChip Status="@r.Status" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private bool ready;
    private List<BillRow> bills = [];
    private bool loaded;
    private string status = "";
    private string periode = DateTime.Now.ToString("yyyy-MM");

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; }
        ready = true;
        await Load();
    }

    private async Task OnStatus(string v) { status = v; await Load(); }
    private async Task Load() { bills = await Billing.ListAsync(status); loaded = true; }

    private Task Generate() =>
        Snack.Try(async () =>
        {
            var n = await Billing.GenerateAsync(periode);
            await Load();
            return $"{n} tagihan digenerate.";
        }, Snackbar);
}
