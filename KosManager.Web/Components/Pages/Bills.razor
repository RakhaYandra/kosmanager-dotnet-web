@page "/bills"
@inject BillingService Billing
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Tagihan — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="d-flex align-center gap-3 mb-4">
        <MudText Typo="Typo.h4" Style="font-weight:700;">Tagihan</MudText>
        <MudSpacer />
        @if (Auth.IsOwner)
        {
            <MudTextField T="string" Label="Periode" Placeholder="2026-10" @bind-Value="periode" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:140px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate">Generate</MudButton>
        }
    </div>
    <div class="d-flex gap-2 mb-4">
        @foreach (var opt in FilterOptions)
        {
            <MudChip T="string" Variant="@(status == opt.Value ? Variant.Filled : Variant.Outlined)" Color="@(status == opt.Value ? Color.Primary : Color.Default)" OnClick="@(() => OnStatus(opt.Value))">@opt.Label</MudChip>
        }
    </div>
    @if (!loaded) { <MudProgressCircular Indeterminate="true" /> }
    else if (bills.Count == 0) { <MudAlert Severity="Severity.Success">Belum ada tunggakan 🎉</MudAlert> }
    else
    {
        <MudTable Items="bills" Hover="true" Elevation="2" Context="r">
            <HeaderContent>
                <MudTh>Penghuni</MudTh><MudTh>Periode</MudTh><MudTh>Nominal</MudTh><MudTh>Jatuh tempo</MudTh><MudTh>Status</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@r.Tenant</MudTd>
                <MudTd Class="mono">@r.Period</MudTd>
                <MudTd Class="mono">@r.Amount</MudTd>
                <MudTd Class="mono">@r.Due</MudTd>
                <MudTd><StatusChip Status="@r.Status" /></MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" OnClick="@(() => Receipt(r.Id))" aria-label="Unduh struk" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private bool ready;
    private List<BillRow> bills = [];
    private bool loaded;
    private string status = "";
    private static readonly (string Value, string Label)[] FilterOptions =
    [
        ("", "Semua"), ("unpaid", "Belum"), ("pending", "Pending"), ("paid", "Lunas"),
    ];
    private string periode = DateTime.Now.ToString("yyyy-MM");

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; }
        ready = true;
        await Load();
    }

    private async Task OnStatus(string v) { status = v; await Load(); }
    private async Task Load() { bills = await Billing.ListAsync(status); loaded = true; }

    private Task Generate() =>
        Snack.Try(async () =>
        {
            var n = await Billing.GenerateAsync(periode);
            await Load();
            return $"{n} tagihan digenerate.";
        }, Snackbar);

    private Task Receipt(int id) =>
        Snack.Try(async () =>
        {
            var bytes = await Billing.ReceiptAsync(id);
            await JS.InvokeVoidAsync("kmDownloadPdf", $"struk-{id}.pdf", Convert.ToBase64String(bytes));
            return "Struk diunduh.";
        }, Snackbar);
}
