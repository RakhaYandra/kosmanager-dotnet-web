@page "/tenants"
@inject TenantService TenantSvc
@inject AuthState Auth
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Penghuni — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Style="font-weight:700;" Class="mb-4">Penghuni</MudText>
    <MudTable Items="tenants" Hover="true" Elevation="2" Context="t">
        <HeaderContent><MudTh>Nama</MudTh><MudTh>HP</MudTh><MudTh>Kamar</MudTh><MudTh>Masuk</MudTh><MudTh>Telegram</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@t.Name</MudTd>
            <MudTd Class="mono">@t.Phone</MudTd>
            <MudTd>@t.Room</MudTd>
            <MudTd Class="mono">@t.MoveIn</MudTd>
            <MudTd>@(t.HasTelegram ? "✓" : "—")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool ready;
    private List<TenantDto> tenants = [];

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; }
        tenants = await TenantSvc.ListAsync();
        ready = true;
    }
}
