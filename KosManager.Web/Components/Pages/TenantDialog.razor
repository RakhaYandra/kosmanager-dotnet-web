@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="Nama" @bind-Value="Name" Variant="Variant.Outlined" FullWidth="true" />
        <MudTextField T="string" Label="HP" @bind-Value="Phone" Variant="Variant.Outlined" FullWidth="true" Class="mt-3" />
        <MudTextField T="string" Label="Tanggal masuk (YYYY-MM-DD)" @bind-Value="MoveIn" Variant="Variant.Outlined" FullWidth="true" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Phone { get; set; } = "";
    [Parameter] public string MoveIn { get; set; } = "2026-09-01";

    private void Save() => Dialog.Close(DialogResult.Ok((Name, Phone, MoveIn)));
    private void Cancel() => Dialog.Cancel();
}
