@page "/dashboard"
@inject DashboardService DashSvc
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Dashboard — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="d-flex align-center gap-3 mb-4">
        <MudText Typo="Typo.h4" Style="font-weight:700;">Dashboard</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="DownloadCsv">Unduh CSV</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TestSend">Kirim test</MudButton>
    </div>
    @if (dash is null) { <MudProgressCircular Indeterminate="true" /> }
    else
    {
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="6" md="3"><MudCard Class="pa-4"><MudText Class="km-label">Okupansi</MudText><MudText Class="km-stat-num">@dash.Occupancy</MudText></MudCard></MudItem>
            <MudItem xs="6" md="3"><MudCard Class="pa-4"><MudText Class="km-label">Kas bulan ini</MudText><MudText Class="km-stat-num">@dash.Kas</MudText></MudCard></MudItem>
            <MudItem xs="6" md="3"><MudCard Class="pa-4"><MudText Class="km-label">Tunggakan</MudText><MudText Class="km-stat-num">@dash.Tunggakan</MudText></MudCard></MudItem>
            <MudItem xs="6" md="3"><MudCard Class="pa-4"><MudText Class="km-label">Reminder terkirim</MudText><MudText Class="km-stat-num">@dash.Reminders</MudText></MudCard></MudItem>
        </MudGrid>
        <MudText Typo="Typo.h6" Class="mb-2">Tunggakan teratas</MudText>
        <MudTable Items="dash.Overdue" Hover="true" Elevation="2" Context="o">
            <HeaderContent><MudTh>Penghuni</MudTh><MudTh>Nominal</MudTh><MudTh>Jatuh tempo</MudTh><MudTh>Telat</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@o.Tenant</MudTd>
                <MudTd Class="mono">@o.Amount</MudTd>
                <MudTd Class="mono">@o.Due</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">H+@o.DaysLate</MudChip></MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private bool ready;
    private DashboardDto? dash;
    private string chatId = "12345";

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; }
        ready = true;
        dash = await DashSvc.GetAsync();
    }

    private Task TestSend() =>
        Snack.Try(async () =>
        {
            var ch = await DashSvc.TestSendAsync(chatId);
            dash = await DashSvc.GetAsync();
            return $"Terkirim via {ch}.";
        }, Snackbar);

    private Task DownloadCsv() =>
        Snack.Try(async () =>
        {
            var bytes = await DashSvc.ReportCsvAsync();
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("kmDownload", "rekap.csv", b64);
            return "CSV diunduh.";
        }, Snackbar);
}
