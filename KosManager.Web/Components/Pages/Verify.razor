@page "/verify"
@inject PaymentService Payments
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Verifikasi — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Style="font-weight:700;" Class="mb-4">Antrean Verifikasi</MudText>
    @if (!loaded) { <MudProgressCircular Indeterminate="true" /> }
    else if (queue.Count == 0) { <MudAlert Severity="Severity.Success">Antrean kosong — semua terverifikasi.</MudAlert> }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var p in queue)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.h6">@p.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mono">@p.Meta</MudText>
                        <div class="d-flex gap-2 mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Decide(p.Id, true))">Setuju</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => Decide(p.Id, false))">Tolak</MudButton>
                        </div>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private bool ready;
    private List<PayRow> queue = [];
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; }
        ready = true;
        await Load();
    }

    private async Task Load() { queue = await Payments.QueueAsync(); loaded = true; }

    private Task Decide(int id, bool ok) =>
        Snack.Try(async () =>
        {
            await Payments.DecideAsync(id, ok);
            await Load();
            return ok ? "Lunas." : "Ditolak.";
        }, Snackbar);
}
