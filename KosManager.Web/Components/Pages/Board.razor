@page "/"
@inject RoomService Rooms
@inject AuthState Auth
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Board — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!Auth.IsOwner) { Nav.NavigateTo("/my-bills"); }
else
{
    <div class="d-flex align-center gap-3 mb-4">
        <MudText Typo="Typo.h4" Style="font-weight:700;">Board Kamar</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">@rooms.Count(r => r.Tenant is not null)/@rooms.Count terisi</MudChip>
    </div>
    <MudGrid Spacing="3">
        @foreach (var r in rooms)
        {
            var full = r.Tenant is not null;
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="pa-4">
                    <div class="d-flex align-center">
                        <MudText Typo="Typo.h5" Style="font-weight:700;">@r.Number</MudText>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Color="@(full ? Color.Success : Color.Default)" Variant="Variant.Filled">@(full ? "Isi" : "Kosong")</MudChip>
                    </div>
                    <MudText Typo="Typo.body1" Class="mt-1">@(r.Tenant ?? "—")</MudText>
                    <MudText Typo="Typo.caption" Class="mono">@r.Price / bln</MudText>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<RoomDto> rooms = [];
    private bool ready;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; }
        if (!Auth.IsOwner) { ready = true; return; }
        rooms = await Rooms.ListAsync();
        ready = true;
    }
}
