@page "/my-bills"
@inject BillingService Billing
@inject PaymentService Payments
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Tagihanku — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Style="font-weight:700;" Class="mb-4">Tagihanku</MudText>
    @if (!loaded) { <MudProgressCircular Indeterminate="true" /> }
    else if (bills.Count == 0) { <MudAlert Severity="Severity.Success">Lunas semua 🎉</MudAlert> }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var b in bills)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4">
                        <div class="d-flex align-center">
                            <MudText Typo="Typo.h6" Class="mono">@b.Period</MudText>
                            <MudSpacer />
                            <StatusChip Status="@b.Status" />
                        </div>
                        <MudText Class="km-stat-num mt-1">@b.Amount</MudText>
                        <MudText Typo="Typo.caption" Class="mono">Jatuh tempo @b.Due</MudText>
                        @if (b.Status == "unpaid")
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-3" OnClick="@(() => Pay(b.Id))">SUDAH BAYAR</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-3" OnClick="@(() => Receipt(b.Id))">Unduh Struk</MudButton>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private bool ready;
    private List<BillRow> bills = [];
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; }
        ready = true;
        await Load();
    }

    private async Task Load() { bills = await Billing.ListAsync(); loaded = true; }

    private Task Pay(int billId) =>
        Snack.Try(async () =>
        {
            await Payments.PayAsync(billId);
            await Load();
            return "Tercatat, menunggu verifikasi owner.";
        }, Snackbar);

    private Task Receipt(int id) =>
        Snack.Try(async () =>
        {
            var bytes = await Billing.ReceiptAsync(id);
            await JS.InvokeVoidAsync("kmDownloadPdf", $"struk-{id}.pdf", Convert.ToBase64String(bytes));
            return "Struk diunduh.";
        }, Snackbar);
}
