@page "/my-bills"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snack
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Tagihanku — kosmanager</PageTitle>

@if (!ready)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Style="font-weight:700;" Class="mb-4">Tagihanku</MudText>
    @if (!loaded) { <MudProgressCircular Indeterminate="true" /> }
    else if (bills.Count == 0) { <MudAlert Severity="Severity.Success">Lunas semua 🎉</MudAlert> }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var b in bills)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4">
                        <div class="d-flex align-center">
                            <MudText Typo="Typo.h6" Class="mono">@b.Period</MudText>
                            <MudSpacer />
                            <StatusChip Status="@b.Status" />
                        </div>
                        <MudText Class="km-stat-num mt-1">Rp @b.Amount</MudText>
                        <MudText Typo="Typo.caption" Class="mono">Jatuh tempo @b.Due</MudText>
                        @if (b.Status == "unpaid")
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-3" OnClick="@(() => Pay(b.Id))">SUDAH BAYAR</MudButton>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private bool ready;
    private List<BillCard> bills = [];
    private bool loaded;
    private static readonly System.Globalization.CultureInfo Id = new("id-ID");
    private record BillCard(int Id, string Period, string Amount, string Due, string Status);

    protected override async Task OnInitializedAsync() { await Auth.EnsureLoadedAsync(); if (!Auth.LoggedIn) { Nav.NavigateTo("/login"); return; } ready = true; if (true) await Load(); }
    private async Task Load()
    {
        var raw = await Api.Get<List<System.Text.Json.JsonElement>>("/api/bills") ?? [];
        bills = raw.Select(b => new BillCard(
            b.GetProperty("id").GetInt32(),
            b.GetProperty("period").GetString()!,
            b.GetProperty("amount").GetDecimal().ToString("N0", Id),
            b.GetProperty("dueDate").GetString()!,
            b.GetProperty("status").GetString()!)).ToList();
        loaded = true;
    }
    private async Task Pay(int billId)
    {
        try { await Api.Post<bool>("/api/payments", new { billId, method = "transfer" }); Snack.Add("Tercatat, menunggu verifikasi owner.", Severity.Success); await Load(); }
        catch (Exception ex) { Snack.Add(ex.Message, Severity.Error); }
    }
}
