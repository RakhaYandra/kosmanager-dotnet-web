@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthState Auth
@inject UiState Ui
@implements IDisposable

@if (Auth.LoggedIn)
{
    <div class="km-rail @(Ui.DrawerOpen ? "open" : "")">
        <MudNavMenu>
            @if (Auth.IsOwner)
            {
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.GridView">Board</MudNavLink>
                <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.People">Penghuni</MudNavLink>
                <MudNavLink Href="/bills" Icon="@Icons.Material.Filled.Receipt">Tagihan</MudNavLink>
                <MudNavLink Href="/verify" Icon="@Icons.Material.Filled.FactCheck">Verifikasi</MudNavLink>
                <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            }
            else
            {
                <MudNavLink Href="/my-bills" Icon="@Icons.Material.Filled.Receipt">Tagihanku</MudNavLink>
            }
        </MudNavMenu>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += StateHasChanged;
        Ui.Changed += StateHasChanged;
        await Auth.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        Auth.Changed -= StateHasChanged;
        Ui.Changed -= StateHasChanged;
    }
}
